{
  "name": "books",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo containing book example projects and starter kits",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@tailwindcss/typography": "0.5.19",
    "autoprefixer": "10.4.23",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.0"
  },
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:css": "npx tailwindcss -i ./packages/book1-portfolio/reader/styles/input.css -o ./packages/book1-portfolio/reader/styles/output.css --minify",
    "dev": "npm run dev:css",
    "build:css": "npx tailwindcss -i ./packages/book1-portfolio/reader/styles/input.css -o ./packages/book1-portfolio/reader/styles/output.css --minify",
    "server": "node server.js",
    "pdf": "node ./packages/book1-portfolio/reader/scripts/build-pdf.js",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "serve": "npx serve packages/book1-portfolio",
    "build": "npm run build:css && npm run build:pdf"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "md-to-pdf": "^5.2.5",
    "tailwindcss": "^3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atopwebtechnologies/books.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/atopwebtechnologies/books/issues"
  },
  "homepage": "https://github.com/atopwebtechnologies/books#readme"
}
